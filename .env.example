# Postgres connection string (Neon). Required.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign stateless execute tokens (HMAC-SHA256). Required.
# Use a long random string, e.g. `openssl rand -hex 32`.
SERVER_SECRET=change-me-to-a-long-random-string

# Admin key that guards /debug/[wid]?key=ADMIN_KEY. Required for debug access.
ADMIN_KEY=change-me-too
